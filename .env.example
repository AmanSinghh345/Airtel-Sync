# Database Configuration
POSTGRES_DB=udyamone_db
POSTGRES_USER=postgres_user_placeholder
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5434

# Connection string for Prisma (Local Docker)
DATABASE_URL="postgresql://postgres_user_placeholder:your_secure_password_here@localhost:5434/udyamone_db?schema=public"

# Production Connection (Neon PostgreSQL)
# DATABASE_URL="postgresql://user:pass@ep-cool-db.us-east-2.aws.neon.tech/udyamone_db?sslmode=require"

# Challenge reference date
CHALLENGE_REFERENCE_DATE="2026-07-15"

# Optional Gemini API key for natural language advisor (fallback engine active if omitted)
GEMINI_API_KEY=""

# JWT Staff Authentication
JWT_SECRET="your_jwt_signing_secret_here"
JWT_ISSUER="udyamone-auth"
JWT_AUDIENCE="udyamone-staff"
JWT_EXPIRES_IN="8h"

# Regulatory Audit Retention (Days) - Configurable policy for telecom KYC audit logs
KYC_AUDIT_RETENTION_DAYS="2555"
