{
  "name": "@udyamone/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test:smoke": "ts-node test/smoke.ts",
    "test:phase2": "ts-node -r dotenv/config test/phase2-catalog-quote.spec.ts",
    "test:phase3": "ts-node -r dotenv/config test/phase3-advisor.spec.ts",
    "test:phase4": "ts-node -r dotenv/config test/phase4-kyc.spec.ts",
    "test:phase5": "ts-node -r dotenv/config test/phase5-orders.spec.ts",
    "test:phase6": "ts-node -r dotenv/config test/phase6-partner-recovery.spec.ts",
    "test:security": "ts-node -r dotenv/config test/security-auth.spec.ts",
    "test:audit:isolation": "ts-node -r dotenv/config test/partner-isolation-audit.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@prisma/client": "^5.19.1",
    "@udyamone/shared-types": "*",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
